{
  "name": "desktop",
  "private": true,
  "version": "1.2.7",
  "description": "کوبیتا — نرم‌افزار حسابداری آفلاین/آنلاین",
  "author": "ipnetcity.ir",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "rebuild-native": "node scripts/rebuild-native.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "publish-update": "node scripts/publish-update.mjs",
    "verify-update-channel": "electron scripts/verify-update-channel.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "jalaali-js": "^2.0.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^42.6.1",
    "electron-builder": "^26.15.3",
    "js-yaml": "^5.2.1",
    "oxlint": "^1.71.0",
    "semver": "^7.8.5",
    "typescript": "~6.0.2",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  },
  "build": {
    "appId": "ir.ipnetcity.cubita",
    "productName": "Cubita",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://acc.cubita.ir/updates/"
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "کوبیتا",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/license.rtf",
      "warningsAsErrors": false
    }
  }
}
