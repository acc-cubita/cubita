# آدرسِ بک‌اند برای اپ موبایل.
#
# پیش‌فرض (این متغیر را ست نکن): اپ به سرورِ اصلی https://acc.cubita.ir وصل می‌شود —
# یعنی همان حساب‌هایی که با برنامه‌ی دسکتاپ/وب ساخته‌ای.
#
# برای اتصال به بک‌اندِ شبکه‌ی داخلی (تست/سرورِ محلی)، این فایل را به mobile/.env کپی
# کن و آدرس را بگذار (بک‌اند باید با --host 0.0.0.0 اجرا شده باشد):
#
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000   # گوشیِ واقعی روی همان WiFi
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000        # امولاتورِ اندروید → localhostِ کامپیوتر
