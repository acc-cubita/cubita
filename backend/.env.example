# کپی به .env و مقادیر واقعی را جایگزین کنید
ENV=development

DATABASE_URL=postgresql+psycopg://hesabdari:hesabdari@localhost:5432/hesabdari

JWT_SECRET=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# کلیدِ رمزگذاریِ رازها در حالتِ سکون — امروز فقط کلیدِ امضای سامانه‌ی مؤدیان.
# خالی = رمزگذاری خاموش (رفتارِ پیش از مهاجرتِ ۰۱۴۸).
#
# **کنارِ نسخه‌ی پشتیبانِ دیتابیس نگه داشته نشود** — اگر کنارِ داده بنشیند
# رمزگذاری نمایشی است؛ تهدیدی که می‌بندد دقیقاً «دیتابیسِ دزدیده‌شده» است.
#
# **اگر گم شود کلیدهای امضا برنمی‌گردند** و هر کسب‌وکار باید کلیدش را دوباره
# از کارپوشه بگیرد و آپلود کند.
#
# تولید: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRETS_KEY=

# اپِ ستاد (admin.cubita.ir) از همان مبدأ خودش /api/ را صدا می‌زند، پس در حالتِ
# هم‌مبدأ چیزی به این فهرست اضافه نمی‌شود. اگر روزی میان‌مبدأ شد، آدرسش اینجا بیاید.
ALLOWED_ORIGINS=http://localhost:5173,app://desktop

# ادمین کنترل‌پنل فروش کوبیتا (/api/admin/purchases). عمداً جدا از RBAC مستأجر است.
# خالی = دسترسی برای همه بسته. چند ایمیل را با کاما جدا کنید.
PLATFORM_ADMIN_EMAILS=

# ── هویتِ ستادِ admin.cubita.ir ───────────────────────────────────────────────
# این دو فقط برای **سیدِ اولیه**ی مهاجرت ۰۱۸۰ به کار می‌روند: برای هر ایمیلِ این
# فهرست یک ردیفِ owner در platform_admins ساخته می‌شود تا روزِ اول کسی بیرون
# نماند. بعد از آن، کاربرانِ ستاد از خودِ اپِ ستاد مدیریت می‌شوند و این متغیر
# دیگر نقشی در احراز هویت ندارد.
SUPER_ADMIN_EMAILS=

# آدرسِ اپِ ستاد. جدا از APP_URL (اپِ مشتری) — اشتباه گرفتنشان یعنی لینکِ ستادی
# به صفحه‌ای می‌رود که آن کار را ندارد.
ADMIN_URL=http://localhost:5175

# پلِ سازگاریِ کوچ. تا وقتی true است، توکنِ مستأجریِ یک سوپرادمینِ قدیمی هنوز به
# /api/admin/* می‌رسد تا باندلِ مستقرِ acc.cubita.ir در فاصله‌ی دو استقرار نشکند.
# **بعد از کوچ باید false شود** — و این تنها قدمی است که استقرار نمی‌خواهد.
LEGACY_ADMIN_ALLOWLIST=true

# اتصال به سایت فروشگاهی (ipnetcity.ir) - یک کاربر ادمین اختصاصی روی همان سایت بسازید
# (نه اکانت شخصی مدیر) تا این سرویس هر sync با همان ایمیل/رمز لاگین و توکن تازه بگیرد
STOREFRONT_API_BASE_URL=https://ipnetcity.ir
STOREFRONT_ADMIN_EMAIL=
STOREFRONT_ADMIN_PASSWORD=

# درگاه پرداخت زرین‌پال برای خرید پلن‌های سایت تجاری cubita.ir
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
BACKEND_URL=http://localhost:8000
MARKETING_SITE_URL=http://localhost:5174

# اعلان ایمیلی به مدیر وقتی یک خرید جدید در سایت تجاری پرداخت می‌شود (خالی = غیرفعال)
# Gmail: باید یک App Password بسازید (myaccount.google.com/security -> 2-Step Verification -> App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_NOTIFY_EMAIL=

# پیامک (ملی‌پیامک، کنسولِ جدید). خالی = پیامک غیرفعال.
# MELIPAYAMAK_API_KEY: کلیدِ کنسول (console.melipayamak.com -> وب‌سرویس)
# MELIPAYAMAK_SENDER: شماره‌ی خطِ اختصاصی برای پیامکِ متنیِ آزاد (یادآوری/رسید)
# MELIPAYAMAK_OTP_PATTERN_ID: کدِ الگوی تأییدشده‌ی خطِ اشتراکی برای کدها (فعال‌سازی/بازیابیِ رمز)
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_SENDER=
MELIPAYAMAK_OTP_PATTERN_ID=
